{
    "name": "shell-config",
    "version": "2.24.1",
    "private": false,
    "description": "CLI Tool for MacOS setup",
    "homepage": "https://github.com/Avivbens/shell-config#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Avivbens/shell-config.git"
    },
    "license": "MIT",
    "author": "Aviv Ben Shahar",
    "bin": "dist/src/main.js",
    "scripts": {
        "build": "nest build",
        "docs:build": "vitepress build docs",
        "docs:dev": "vitepress dev docs",
        "docs:preview": "vitepress preview docs",
        "format": "prettier --write \"src/**/*.ts\"",
        "lint": "eslint \"src/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" --fix",
        "pack": "./project-scripts/pack.js",
        "pack-local": "./project-scripts/pack-local.sh",
        "prepare": "husky || exit 0",
        "start": "node dist/src/main.js",
        "start:debug": "nest start --debug --watch",
        "start:dev": "ts-node src/main.ts",
        "start:prod": "node dist/src/main.js",
        "test": "vitest run",
        "test:debug": "vitest --inspect-brk --no-file-parallelism",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@inquirer/core": "^8.2.4",
        "@inquirer/figures": "^1.0.15",
        "@inquirer/type": "^1.5.5",
        "@nestjs/axios": "^4.0.1",
        "@nestjs/common": "^11.2.11",
        "@nestjs/core": "^11.2.11",
        "ansi-escapes": "^4.3.2",
        "axios": "^1.21.1",
        "boxen": "^5.1.2",
        "chalk": "^4.1.2",
        "inquirer": "^8.2.7",
        "listr2": "^3.14.0",
        "nest-commander": "^3.21.0",
        "ora": "^5.4.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "semver": "^7.8.6"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@eslint/js": "^10.0.1",
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.2.11",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/exec": "^7.1.0",
        "@semantic-release/git": "^11.0.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/inquirer": "^8.2.13",
        "@types/node": "^22.20.5",
        "@types/semver": "^7.8.0",
        "@vitest/eslint-plugin": "^1.6.28",
        "@yao-pkg/pkg": "^5.11.5",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsonc": "^3.4.2",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-unused-imports": "^4.4.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.2",
        "prettier": "^3.10.1",
        "prettier-plugin-packagejson": "^3.1.0",
        "semantic-release": "^25.0.9",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.73.0",
        "vite": "^8.3.8",
        "vitepress": "^1.6.4",
        "vitest": "^5.1.1"
    },
    "packageManager": "pnpm@12.11.2",
    "engines": {
        "node": ">=22.22.1"
    },
    "pkg": {
        "scripts": "dist/**/*.js",
        "assets": [
            "assets/**/*",
            "zsh/**/*"
        ],
        "targets": [
            "node20-macos-x64"
        ],
        "outputPath": "bin"
    }
}
